  "destinations": [
    {
      "name": "Kalimpong",
      "description": "A hilltop town located at the east of river Teesta, situated at an altitude of 1,200 mtrs, some 50 kms to the east of Darjeeling. Because of its location at a relatively lower altitude, the weather is milder and pleasant throughout the year. An ideal location for tourists looking for a comfortable stay with a picturesque view of the Kanchenjunga and other Himalayan snow peaks.",
      "category": "Top Destination"
    },
    {
      "name": "Sundarbans",
      "description": "One of the largest mangrove ecosystems globally. The delta is spread over India and Bangladesh with an area of approximately 10,000 sq kms and is the largest halophytic mangrove forest in the world. It is a delta of the two great Indian rivers - The Ganga and The Brahmaputra.",
      "category": "Top Destination"
    },
    {
      "name": "Digha",
      "description": "A popular seaside resort town in Purba Medinipur district of West Bengal, known for its wide sandy beaches and gentle waves.",
      "category": "Top Destination"
    },
    {
      "name": "Darjeeling",
      "description": "Nestled in the Himalayan range in Northern Bengal, popularly known as the 'Queen of Hills', esteemed for its scenic beauty, snow peaks, vibrant green hills, views of green tea bushes and quaint township. The district hosts people from across the world and has various kinds of stays.",
      "category": "Top Destination"
    },
    {
      "name": "Dooars",
      "description": "The foothills of the eastern Himalayas in North-East India around Bhutan. Located in northeastern part of West Bengal along the foothills of Eastern Himalayas, considered the gateway to Bhutan from India. One of the very few places left in the country with rich biodiversity.",
      "category": "Top Destination"
    },
    {
      "name": "Santiniketan",
      "description": "A small town near Bolpur in the Birbhum district, about 212 kms north of Kolkata. In 1862, Maharshi Debendranath Tagore came across the landscape with red soil and lush greenery. Home to Visva-Bharati University founded by Rabindranath Tagore.",
      "category": "Top Destination"
    },
    {
      "name": "Purulia",
      "description": "A district in West Bengal known for its tribal culture, Chhau dance, and natural landscapes including Ajodhya Hills.",
      "category": "Top Destination"
    },
    {
      "name": "Kolkata",
      "description": "Known as the 'City of Joy', located on the banks of the Hooghly and one of the biggest cities in India. The city has a rich history and was the capital of India till 1912. A vibrant and diverse city with rich history, culture, and cuisine offering a range of attractions.",
      "category": "Top Destination"
    },
    {
      "name": "Bishnupur",
      "description": "A famous municipality in the Bankura District, located about 132 km from Kolkata. Famous for its terracotta temples and Baluchari sarees. The town has a glorious past reflected in its rich architecture, music, and handicrafts, prospering in the 17th century under the Malla kings.",
      "category": "Top Destination"
    },
