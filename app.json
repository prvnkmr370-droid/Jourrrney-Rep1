{
  "expo": {
    "name": "journey-app",
    "slug": "journey-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "journeyapp",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.journeyapp.mobile"
    },
    "android": {
      "package": "com.journeyapp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_ANDROID_MAPS_API_KEY"
        }
      }
    },
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Journey uses your location to suggest a starting city for trip planning and nearby destinations."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Jourrrney uses your photos so Tia can suggest a destination inspired by a picture you share.",
          "cameraPermission": "Jourrrney uses your camera so Tia can suggest a destination inspired by a photo you take."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6ab3179-3a85-49c2-8f32-2c9a8d6e1525"
      }
    },
    "owner": "prvnkmr370"
  }
}
