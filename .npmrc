# expo-router pulls in web-only transitive deps (vaul, @radix-ui/react-tabs)
# whose react-dom peer ranges conflict with the versions actually
# installed for this native app — irrelevant to a native build, but npm's
# strict peer resolution fails on it regardless. Same flag we needed
# locally to install expo-dev-client; EAS Build's own npm install needs it
# too, hence this file (EAS respects .npmrc automatically).
legacy-peer-deps=true
